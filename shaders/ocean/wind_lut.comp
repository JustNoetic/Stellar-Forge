#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "common/procedural_noise.glsl"

layout(r16f, set = 0, binding = 0) uniform writeonly image2DArray u_wind_out;

vec3 cube_face_dir(uint face, vec2 uv) {
    switch (face) {
    case 0u: return vec3( 1.0, -uv.y, -uv.x);
    case 1u: return vec3(-1.0, -uv.y,  uv.x);
    case 2u: return vec3( uv.x,  1.0,  uv.y);
    case 3u: return vec3( uv.x, -1.0, -uv.y);
    case 4u: return vec3( uv.x, -uv.y,  1.0);
    default: return vec3(-uv.x, -uv.y, -1.0);
    }
}

void main() {
    uint side = uint(imageSize(u_wind_out).x);
    if (gl_GlobalInvocationID.x >= side || gl_GlobalInvocationID.y >= side) return;
    vec2 uv = (vec2(gl_GlobalInvocationID.xy) + 0.5) / float(side) * 2.0 - 1.0;
    vec3 dir = normalize(cube_face_dir(gl_GlobalInvocationID.z, uv));
    float n = fbm_noise(dir * 7.0 + vec3(3.1, 1.7, 5.3), 3, 2.1, 0.5);
    imageStore(u_wind_out, ivec3(gl_GlobalInvocationID), vec4(n, 0.0, 0.0, 1.0));
}
