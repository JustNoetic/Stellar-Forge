#version 460

#include "common/celestial_scene.glsl"
#include "common/eclipse_optics.glsl"

layout(local_size_x = 64) in;
struct EclipseSample { vec4 radii_center; vec4 pole_source; };
layout(std430, set = 0, binding = 4) readonly buffer Inputs { EclipseSample samples[]; };
layout(std430, set = 0, binding = 8) writeonly buffer Outputs { vec4 results[]; };
layout(push_constant) uniform Push { uint count; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    EclipseSample s = samples[i];
    vec3 pole = normalize(s.pole_source.xyz);
    vec3 perpendicular = vec3(s.radii_center.zw, 0.0);
    float result = eclipse_caster_visibility(s.radii_center.x, s.radii_center.y, pole,
                                           vec3(0, 0, 1), perpendicular, s.pole_source.w);
    float radius = oblate_caster_radius(s.radii_center.x, s.radii_center.y, pole, vec3(0, 0, 1), perpendicular);
    float reference = eclipse_reference_visibility(radius, s.pole_source.w, length(perpendicular));
    results[i] = vec4(result, reference, 0, 0);
}
