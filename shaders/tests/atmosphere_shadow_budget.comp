#version 460
#include "common/atmosphere.glsl"
layout(set = 0, binding = 7) uniform sampler2D transmittance_lut;
layout(set = 0, binding = 8) uniform sampler2D multiscatter_lut;
#include "common/atmosphere_shadow.glsl"
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 1) buffer Results { vec4 budgets[]; };
void main() {
    uint index = gl_GlobalInvocationID.x;
    uint maximum = index < 4u ? 4u : index < 8u ? 8u : 16u;
    uint ray = index%4u;
    vec3 entry = vec3(0.0, 0.0, 1001.0);
    vec3 direction = ray == 0u ? vec3(0.0, 0.0, 1.0) : ray == 1u ? vec3(0.0, 0.0, -1.0) : vec3(1.0, 0.0, 0.0);
    vec2 segment = atmosphere_segment(entry, direction);
    float path = ray == 3u ? 0.1 : segment.y-segment.x;
    float contributing_span;
    float budget = shadow_sample_budget(entry, direction, path, maximum, contributing_span);
    budgets[index] = vec4(budget, contributing_span, path, float(maximum));
}
