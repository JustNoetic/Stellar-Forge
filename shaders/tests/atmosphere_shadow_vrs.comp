#version 460
#define ATMOSPHERE_SHADOW_VRS
#include "common/atmosphere.glsl"
layout(set = 0, binding = 7) uniform sampler2D transmittance_lut;
layout(set = 0, binding = 8) uniform sampler2D multiscatter_lut;
#include "common/atmosphere_shadow.glsl"
#include "common/atmosphere_shadow_vrs.glsl"
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 1) buffer Results { vec4 results[]; };
void main() {
    uint index = gl_GlobalInvocationID.x;
    ivec2 pixel = ivec2(index == 7u ? 0 : index == 8u ? 3 : 1, int(index)*4+(index == 7u ? 0 : 1));
    vec3 fraction = vec3(0.0);
    bool supported;
    bool reused = reconstruct_shadow_vrs(pixel, 0, false, vec3(1.0, 0.0, 0.0), vec2(0.0, 10.0), 10.0, fraction, supported);
    results[index] = vec4(fraction, reused ? 1.0 : 0.0);
}
