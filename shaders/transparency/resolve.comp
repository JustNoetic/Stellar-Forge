#version 460
#define TRANSPARENCY_RING_SLOT
#include "common/transparency.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform Push { uint slot_mode; } pc;
#ifdef HDR_RGBA32F
layout(rgba32f, set = 0, binding = 4) uniform image2D hdr_color;
#else
layout(rgba16f, set = 0, binding = 4) uniform image2D hdr_color;
#endif
layout(set = 0, binding = 3) uniform sampler2D opaque_depth;
#ifdef BLOOM_OUTPUT
layout(rgba16f, set = 0, binding = 5) uniform writeonly image2D physical_color;
#endif

const uint LOCAL_SORT_CAPACITY = 8u;
// Sort key colour standing for the ring slot, whose fp32 colour is blended in its place; packed colours never use it.
const uvec2 RING_SLOT_KEY = uvec2(0xffffffffu);
vec4 ring_color = vec4(0.0);

vec4 key_color(uvec2 packed) { return packed == RING_SLOT_KEY ? ring_color : transparent_color(packed); }
bool key_excludes_bloom(uvec2 packed) { return packed != RING_SLOT_KEY && transparent_excludes_bloom(packed); }

bool fragment_before_val(uvec3 x, uvec3 y) {
    if (x.z != y.z) return x.z < y.z;
    if (x.x != y.x) return x.x < y.x;
    return (x.y & 0x7fffffffu) <= (y.y & 0x7fffffffu);
}

bool fragment_before(uint a, uint b) {
    return fragment_before_val(
        uvec3(transparent_color_packed(a), transparent_depth_bits(a)),
        uvec3(transparent_color_packed(b), transparent_depth_bits(b)));
}

void write_physical_passthrough(ivec2 pixel) {
#ifdef BLOOM_OUTPUT
    vec4 background = imageLoad(hdr_color, pixel);
    imageStore(physical_color, pixel, vec4(min(background.rgb, vec3(65000.0)), 1.0));
#endif
}

void blend_single(ivec2 pixel, uvec2 packed) {
    vec4 background = imageLoad(hdr_color, pixel);
#ifdef BLOOM_OUTPUT
    vec3 physical = background.rgb;
#endif
    vec4 color = key_color(packed);
    background.rgb = color.rgb + (1.0 - color.a) * background.rgb;
#ifdef HDR_RGBA32F
    imageStore(hdr_color, pixel, vec4(background.rgb, background.a));
#else
    imageStore(hdr_color, pixel, vec4(min(background.rgb, vec3(65000.0)), background.a));
#endif
#ifdef BLOOM_OUTPUT
    if (!key_excludes_bloom(packed)) physical = background.rgb;
    imageStore(physical_color, pixel, vec4(min(physical, vec3(65000.0)), 1.0));
#endif
}

uint sort_linked_list(uint sorted) {
    if (sorted == TRANSPARENCY_END || transparent_next(sorted) == TRANSPARENCY_END) return sorted;
    for (uint width = 1u; ; width *= 2u) {
        uint p = sorted;
        sorted = TRANSPARENCY_END;
        uint tail = TRANSPARENCY_END;
        uint merges = 0u;
        while (p != TRANSPARENCY_END) {
            ++merges;
            uint q = p;
            uint left = 0u;
            for (uint i = 0u; i < width && q != TRANSPARENCY_END; ++i) {
                ++left;
                q = transparent_next(q);
            }
            uint right = width;
            while (left > 0u || (right > 0u && q != TRANSPARENCY_END)) {
                uint selected;
                if (left == 0u) {
                    selected = q; q = transparent_next(q); --right;
                } else if (right == 0u || q == TRANSPARENCY_END) {
                    selected = p; p = transparent_next(p); --left;
                } else if (fragment_before(p, q)) {
                    selected = p; p = transparent_next(p); --left;
                } else {
                    selected = q; q = transparent_next(q); --right;
                }
                if (tail == TRANSPARENCY_END) sorted = selected;
                else set_transparent_next(tail, selected);
                tail = selected;
            }
            p = q;
        }
        set_transparent_next(tail, TRANSPARENCY_END);
        if (merges <= 1u) break;
    }
    return sorted;
}

void resolve_multi(ivec2 pixel, uint current, uint depth, bool ringed, uvec3 ring) {
    uvec3 local[LOCAL_SORT_CAPACITY];
    uint kept = 0u;
    bool overflowed = false;
    if (ringed) local[kept++] = ring;
    uint node = current;
    while (node != TRANSPARENCY_END) {
        uint frag_depth = transparent_depth_bits(node);
        if (frag_depth >= depth) {
            if (kept < LOCAL_SORT_CAPACITY) {
                local[kept] = uvec3(transparent_color_packed(node), frag_depth);
                ++kept;
            } else {
                overflowed = true;
                break;
            }
        }
        node = transparent_next(node);
    }
    if (kept == 0u) {
        write_physical_passthrough(pixel);
        return;
    }

    vec4 background = imageLoad(hdr_color, pixel);
#ifdef BLOOM_OUTPUT
    vec3 physical = background.rgb;
#endif
    if (!overflowed) {
        for (uint i = 1u; i < kept; ++i) {
            uvec3 key = local[i];
            uint j = i;
            while (j > 0u && !fragment_before_val(local[j - 1u], key)) {
                local[j] = local[j - 1u];
                --j;
            }
            local[j] = key;
        }
        for (uint i = 0u; i < kept; ++i) {
            uvec2 packed = local[i].xy;
            vec4 color = key_color(packed);
            background.rgb = color.rgb + (1.0 - color.a) * background.rgb;
#ifdef BLOOM_OUTPUT
            if (!key_excludes_bloom(packed)) physical = color.rgb + (1.0 - color.a) * physical;
#endif
        }
    } else {
        uint sorted = sort_linked_list(current);
        while (sorted != TRANSPARENCY_END || ringed) {
            uvec3 key;
            if (sorted == TRANSPARENCY_END) {
                key = ring;
                ringed = false;
            } else {
                key = uvec3(transparent_color_packed(sorted), transparent_depth_bits(sorted));
                if (ringed && fragment_before_val(ring, key)) {
                    key = ring;
                    ringed = false;
                } else {
                    sorted = transparent_next(sorted);
                }
            }
            if (key.z >= depth) {
                vec4 color = key_color(key.xy);
                background.rgb = color.rgb + (1.0 - color.a) * background.rgb;
#ifdef BLOOM_OUTPUT
                if (!key_excludes_bloom(key.xy)) physical = color.rgb + (1.0 - color.a) * physical;
#endif
            }
        }
    }
#ifdef HDR_RGBA32F
    imageStore(hdr_color, pixel, vec4(background.rgb, background.a));
#else
    imageStore(hdr_color, pixel, vec4(min(background.rgb, vec3(65000.0)), background.a));
#endif
#ifdef BLOOM_OUTPUT
    imageStore(physical_color, pixel, vec4(min(physical, vec3(65000.0)), 1.0));
#endif
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(transparency_heads)))) return;
    uint head = imageLoad(transparency_heads, pixel).x;
    if (pc.slot_mode == 2u || (pc.slot_mode == 1u && head != TRANSPARENCY_END)) {
        uint ring_bits = imageLoad(ring_slot_depth, pixel).x & RING_SLOT_DEPTH_MASK;
        uint depth = floatBitsToUint(texelFetch(opaque_depth, pixel, 0).r);
        if (ring_bits != 0u && ring_bits >= depth) {
            ring_color = load_ring_slot(pixel);
            uvec3 ring = uvec3(RING_SLOT_KEY, ring_bits);
            if (head == TRANSPARENCY_END) blend_single(pixel, ring.xy);
            else resolve_multi(pixel, head & TRANSPARENCY_INDEX_MASK, depth, true, ring);
            return;
        }
    }
    if (head == TRANSPARENCY_END) {
        write_physical_passthrough(pixel);
        return;
    }

    if ((head & TRANSPARENCY_MULTI_BIT) == 0u) {
        uint idx = head & TRANSPARENCY_INDEX_MASK;
        if ((head & TRANSPARENCY_DEPTH_BIT) != 0u) {
            uint depth = floatBitsToUint(texelFetch(opaque_depth, pixel, 0).r);
            if (transparent_depth_bits(idx) < depth) {
                write_physical_passthrough(pixel);
                return;
            }
        }
        blend_single(pixel, transparent_color_packed(idx));
        return;
    }

    uint idx0 = head & TRANSPARENCY_INDEX_MASK;
    uint depth = floatBitsToUint(texelFetch(opaque_depth, pixel, 0).r);
    uint idx1 = transparent_next(idx0);
    if (idx1 == TRANSPARENCY_END) {
        if (transparent_depth_bits(idx0) < depth) {
            write_physical_passthrough(pixel);
            return;
        }
        blend_single(pixel, transparent_color_packed(idx0));
        return;
    }

    uint idx2 = transparent_next(idx1);
    if (idx2 == TRANSPARENCY_END) {
        uint d0 = transparent_depth_bits(idx0);
        uint d1 = transparent_depth_bits(idx1);
        bool v0 = d0 >= depth;
        bool v1 = d1 >= depth;
        if (!v0 && !v1) {
            write_physical_passthrough(pixel);
            return;
        }
        if (v0 != v1) {
            blend_single(pixel, transparent_color_packed(v0 ? idx0 : idx1));
            return;
        }
        uvec3 a = uvec3(transparent_color_packed(idx0), d0);
        uvec3 b = uvec3(transparent_color_packed(idx1), d1);
        if (!fragment_before_val(a, b)) {
            uvec3 tmp = a;
            a = b;
            b = tmp;
        }
        vec4 background = imageLoad(hdr_color, pixel);
#ifdef BLOOM_OUTPUT
        vec3 physical = background.rgb;
#endif
        vec4 ca = transparent_color(a.xy);
        background.rgb = ca.rgb + (1.0 - ca.a) * background.rgb;
#ifdef BLOOM_OUTPUT
        if (!transparent_excludes_bloom(a.xy)) physical = ca.rgb + (1.0 - ca.a) * physical;
#endif
        vec4 cb = transparent_color(b.xy);
        background.rgb = cb.rgb + (1.0 - cb.a) * background.rgb;
#ifdef BLOOM_OUTPUT
        if (!transparent_excludes_bloom(b.xy)) physical = cb.rgb + (1.0 - cb.a) * physical;
        imageStore(physical_color, pixel, vec4(min(physical, vec3(65000.0)), 1.0));
#endif
#ifdef HDR_RGBA32F
        imageStore(hdr_color, pixel, vec4(background.rgb, background.a));
#else
        imageStore(hdr_color, pixel, vec4(min(background.rgb, vec3(65000.0)), background.a));
#endif
        return;
    }

    resolve_multi(pixel, idx0, depth, false, uvec3(0u));
}
