#version 460
#include "common/transparency.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform Push { uint capacity; } pc;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(transparency_heads)))) return;
    imageStore(transparency_heads, pixel, uvec4(TRANSPARENCY_END));
    if (all(equal(pixel, ivec2(0)))) {
        fragment_count = 0u;
        overflow_count = 0u;
        fragment_capacity = pc.capacity;
        reserved = 0u;
    }
}
