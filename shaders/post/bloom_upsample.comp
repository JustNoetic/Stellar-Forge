#version 460
#include "common/bloom.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D coarse;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D destination;
layout(set = 0, binding = 2) uniform sampler2D fine;
layout(push_constant) uniform Upsample { float coarse_weight; } upsample;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destination);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel)+0.5)/(2.0*vec2(textureSize(coarse, 0)));
    vec2 texel = 1.0/vec2(textureSize(coarse, 0));
    vec3 value = vec3(0.0);
    for (int y = -1; y <= 1; ++y) for (int x = -1; x <= 1; ++x) {
        float weight = float((x == 0 ? 2 : 1)*(y == 0 ? 2 : 1))/16.0;
        value += bloom_sample(coarse, uv+vec2(x, y)*texel)*weight;
    }
    imageStore(destination, pixel, vec4(mix(texelFetch(fine, pixel, 0).rgb, value, upsample.coarse_weight), 1.0));
}
