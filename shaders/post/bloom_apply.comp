#version 460
#include "common/bloom.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, set = 0, binding = 0) uniform image2D scene;
layout(set = 0, binding = 1) uniform sampler2D physical_scene;
layout(set = 0, binding = 2) uniform sampler2D halo;
layout(push_constant) uniform Bloom { float strength; float highlight_limit; } bloom;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(scene);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel)+0.5)/(2.0*vec2(textureSize(halo, 0)));
    vec4 color = imageLoad(scene, pixel);
    vec3 physical = bloom_extract(texelFetch(physical_scene, pixel, 0).rgb, bloom.highlight_limit);
    color.rgb = bloom_finite(bloom_finite(color.rgb)+bloom.strength*(bloom_sample(halo, uv)-physical));
    imageStore(scene, pixel, color);
}
