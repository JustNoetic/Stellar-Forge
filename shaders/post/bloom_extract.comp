#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require
#include "common/bloom.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D source;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D destination;
layout(std430, set = 0, binding = 2) buffer Spikes { uvec4 command; BloomSpike spikes[]; };
layout(push_constant) uniform Extract { vec2 direction; float highlight_limit; float diffraction; float threshold; uint capacity; } extract;

const int APRON = 20;
shared vec4 light[APRON][APRON];
shared vec3 rows[APRON][4];
shared vec4 energy[64];
shared vec4 moments[64];
shared float cross_moments[64];
shared bool emitted;
shared uint emitted_slot;
shared vec2 profile_origin;
shared vec2 spike_center;

// Box 4 convolved with box 5: every full-resolution pixel lands on two quarter
// texels per axis with a combined weight of 1/4, so flux is phase independent.
const float TENT[8] = float[](1, 2, 3, 4, 4, 3, 2, 1);

void main() {
    ivec2 size = textureSize(source, 0);
    ivec2 origin = ivec2(gl_WorkGroupID.xy)*16-2;
    uint index = gl_LocalInvocationIndex;
    vec4 tile_energy = vec4(0.0), tile_moments = vec4(0.0);
    float tile_cross = 0.0;
    for (uint i = index; i < uint(APRON*APRON); i += 64u) {
        ivec2 texel = ivec2(i%uint(APRON), i/uint(APRON));
        ivec2 p = origin+texel;
        vec3 raw = vec3(0.0);
        if (all(greaterThanEqual(p, ivec2(0))) && all(lessThan(p, size))) raw = bloom_finite(texelFetch(source, p, 0).rgb);
        vec3 value = bloom_extract(raw, extract.highlight_limit);
        float spike = extract.diffraction*smoothstep(extract.threshold, 2.0*extract.threshold, max(raw.r, max(raw.g, raw.b)));
        light[texel.y][texel.x] = vec4(value, spike);
        if (spike > 0.0 && all(greaterThanEqual(texel, ivec2(2))) && all(lessThan(texel, ivec2(18)))) {
            vec3 spike_light = value*spike;
            float weight = dot(spike_light, BLOOM_LUMINANCE);
            vec2 position = vec2(texel-2)+0.5;
            tile_energy += vec4(spike_light, weight);
            tile_moments += weight*vec4(position, position*position);
            tile_cross += weight*position.x*position.y;
        }
    }
    tile_energy = subgroupAdd(tile_energy);
    tile_moments = subgroupAdd(tile_moments);
    tile_cross = subgroupAdd(tile_cross);
    if (subgroupElect()) {
        energy[gl_SubgroupID] = tile_energy;
        moments[gl_SubgroupID] = tile_moments;
        cross_moments[gl_SubgroupID] = tile_cross;
    }
    barrier();
    if (index == 0u) {
        for (uint i = 1u; i < gl_NumSubgroups; ++i) {
            energy[0] += energy[i];
            moments[0] += moments[i];
            cross_moments[0] += cross_moments[i];
        }
        emitted = false;
        vec4 total = energy[0];
        if (total.w > 0.0) {
            uint slot = atomicAdd(command.y, 1u);
            if (slot < extract.capacity) {
                vec4 m = moments[0]/total.w;
                vec2 variance = max(m.zw-m.xy*m.xy, vec2(0.0))+1.0/12.0;
                spike_center = vec2(origin+2)+m.xy;
                spikes[slot].center_variance = vec4(spike_center, variance);
                spikes[slot].energy_covariance = vec4(total.rgb, cross_moments[0]/total.w-m.x*m.y);
                vec2 first = vec2(origin+2)+0.5, last = first+15.0;
                for (uint arm = 0u; arm < 2u; ++arm) {
                    vec2 normal = bloom_spike_normal(extract.direction, arm);
                    profile_origin[arm] = floor(min(min(dot(first, normal), dot(last, normal)),
                        min(dot(vec2(first.x, last.y), normal), dot(vec2(last.x, first.y), normal))))-1.0;
                }
                spikes[slot].profile_origin = vec4(profile_origin, 0.0, 0.0);
                emitted_slot = slot;
                emitted = true;
            }
        }
    }
    barrier();
    if (emitted && index < uint(2*BLOOM_SPIKE_BINS)) {
        uint arm = index/uint(BLOOM_SPIKE_BINS);
        vec2 normal = bloom_spike_normal(extract.direction, arm);
        vec2 axis = vec2(normal.y, -normal.x);
        float bin = profile_origin[arm]+float(index%uint(BLOOM_SPIKE_BINS));
        vec3 sum = vec3(0.0);
        for (int y = 2; y < 18; ++y) for (int x = 2; x < 18; ++x) {
            vec4 value = light[y][x];
            if (value.a <= 0.0) continue;
            vec2 position = vec2(origin+ivec2(x, y))+0.5;
            float weight = bloom_spline(dot(position, normal)-bin)*dot(value.rgb, BLOOM_LUMINANCE)*value.a;
            float along = dot(position-spike_center, axis);
            sum += weight*vec3(1.0, along, along*along);
        }
        spikes[emitted_slot].profile[index] = vec4(sum.x/energy[0].w, sum.x > 0.0 ? sum.yz/sum.x : vec2(0.0), 0.0);
    }
    barrier();
    for (uint i = index; i < uint(APRON*4); i += 64u) {
        int row = int(i/4u), column = int(i%4u)*4;
        bool core_row = row >= 2 && row < 18;
        vec3 sum = vec3(0.0);
        for (int x = 0; x < 8; ++x) {
            vec4 value = light[row][column+x];
            bool core = core_row && column+x >= 2 && column+x < 18;
            sum += value.rgb*((1.0-(core && !emitted ? 0.0 : value.a))*TENT[x]);
        }
        rows[row][i%4u] = sum;
    }
    barrier();
    if (index >= 16u) return;
    ivec2 local = ivec2(index%4u, index/4u);
    ivec2 pixel = ivec2(gl_WorkGroupID.xy)*4+local;
    if (any(greaterThanEqual(pixel, imageSize(destination)))) return;
    vec3 value = vec3(0.0);
    for (int y = 0; y < 8; ++y)
        value += rows[local.y*4+y][local.x]*(TENT[y]/400.0);
    imageStore(destination, pixel, vec4(min(value, vec3(65000.0)), 1.0));
}
