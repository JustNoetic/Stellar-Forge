#version 460
#include "common/size_comparison.glsl"
#include "common/atmosphere.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D transmittance_lut;
layout(set = 0, binding = 2) uniform sampler2D multiscatter_lut;
layout(rgba16f, set = 0, binding = 3) uniform writeonly image2DArray radiance_lut;
layout(rgba16f, set = 0, binding = 4) uniform writeonly image2DArray throughput_lut;
#include "common/size_comparison_air.glsl"
#include "common/size_comparison_transport.glsl"

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel,COMPARISON_TRANSPORT_SIZE))) return;
    vec2 xy = comparison_transport_point(pixel);
    vec3 origin = vec3(xy,top_radius()), ray = vec3(0,0,-1);
    vec2 shell = comparison_roots(origin,ray,top_radius());
    vec2 ground = comparison_roots(origin,ray,cmp.display.x);
    float start = max(shell.x,0.0), end = shell.y;
    bool surface = ground.y >= ground.x && ground.x >= start && ground.x <= end;
    if (surface) end = ground.x;
    vec3 radiance = vec3(0), throughput = vec3(1);
    integrate_air(origin,start,end,radiance,throughput);
    if (surface) throughput *= sunlight(comparison_stretch(origin+ray*ground.x));
    imageStore(radiance_lut,ivec3(pixel,0),vec4(radiance,0));
    imageStore(throughput_lut,ivec3(pixel,0),vec4(throughput,0));
    if (cmp.resources.z > 0.0) {
        float ring_z = -dot(COMPARISON_POLE.xy,xy)/COMPARISON_POLE.z;
        float ring_t = origin.z-ring_z;
        radiance = vec3(0);
        throughput = vec3(1);
        integrate_air(origin,start,min(end,ring_t),radiance,throughput);
        imageStore(radiance_lut,ivec3(pixel,1),vec4(radiance,0));
        imageStore(throughput_lut,ivec3(pixel,1),vec4(throughput,0));
    }
}
