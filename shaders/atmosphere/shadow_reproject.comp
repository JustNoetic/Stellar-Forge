#version 460
#include "common/atmosphere.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 3) uniform sampler2D scene_depth;
layout(set = 0, binding = 7) uniform sampler2D transmittance_lut;
layout(set = 0, binding = 8) uniform sampler2D multiscatter_lut;
#include "common/atmosphere_shadow.glsl"
#include "common/atmosphere_shadow_vrs.glsl"
layout(rgba32f, set = 0, binding = 23) uniform readonly image2DArray history_energy;
layout(rgba32f, set = 0, binding = 24) uniform readonly image2DArray history_loss;
layout(rgba32f, set = 0, binding = 26) uniform writeonly image2D reprojected_energy;
layout(rgba32f, set = 0, binding = 27) uniform writeonly image2D reprojected_loss;
layout(push_constant) uniform Reprojection {
    mat4 current_to_previous;
    mat4 previous_inverse;
} reprojection;

bool reproject_shadow(ivec2 pixel, ivec2 size, out vec4 energy, out vec4 loss) {
    if (atm.camera.w != 1.0 || texelFetch(scene_depth, pixel, 0).r > 0.0) return false;
    vec2 ndc = (vec2(pixel)+0.5)/vec2(size)*2.0-1.0;
    vec3 direction = view_direction(ndc);
    float path;
    vec2 segment = atmosphere_segment(atm.camera.xyz, direction, path);
    if (path <= 0.0 || !shadow_vrs_spatial_safe(direction, segment, path)) return false;
    vec4 previous = reprojection.current_to_previous*vec4(ndc, 1.0, 1.0);
    if (previous.w <= 0.0 || any(greaterThan(abs(previous.xy), vec2(previous.w)))) return false;
    vec2 grid = (previous.xy/previous.w*0.5+0.5)*vec2(size)-0.5;
    ivec2 base = ivec2(floor(grid));
    vec2 f = fract(grid);
    vec3 minimum = vec3(1.0), maximum = vec3(0.0);
    vec3 energy_mean = vec3(0.0), loss_mean = vec3(0.0);
    float count = 8.0;
    bool ground = sphere_roots(atm.camera.xyz, direction, bottom_radius()).x >= 0.0;
    for (int y = 0; y < 2; ++y) for (int x = 0; x < 2; ++x) {
        float weight = (x == 0 ? 1.0-f.x : f.x)*(y == 0 ? 1.0-f.y : f.y);
        if (weight <= 0.0) continue;
        ivec2 tap = base+ivec2(x, y);
        if (any(lessThan(tap, ivec2(0))) || any(greaterThanEqual(tap, size))) return false;
        vec4 e = imageLoad(history_energy, ivec3(tap, 0));
        vec4 l = imageLoad(history_loss, ivec3(tap, 0));
        if (e.a < 1.0 || l.a != 0.0 || imageLoad(history_loss, ivec3(tap, 1)).a >= 0.0) return false;
        vec2 tap_ndc = (vec2(tap)+0.5)/vec2(size)*2.0-1.0;
        vec4 world = reprojection.previous_inverse*vec4(tap_ndc, 1.0, 1.0);
        vec3 d = atmosphere_direction(world.xyz/world.w);
        float p;
        vec2 s = atmosphere_segment(atm.camera.xyz, d, p);
        if (p <= 0.0 || (sphere_roots(atm.camera.xyz, d, bottom_radius()).x >= 0.0) != ground ||
            abs(log2(p/path)) > 0.02 || abs(s.x-segment.x) > 0.01*max(max(path, segment.x), 1.0) ||
            !shadow_vrs_spatial_safe(d, s, p)) return false;
        vec3 fraction = normalized_shadow_loss(l.rgb, e.rgb);
        minimum = min(minimum, fraction);
        maximum = max(maximum, fraction);
        energy_mean += weight*e.rgb/e.a;
        loss_mean += weight*l.rgb/e.a;
        count = min(count, e.a);
    }
    if (any(greaterThan(maximum-minimum, vec3(0.02)))) return false;
    energy = vec4(energy_mean*count, count);
    loss = vec4(loss_mean*count, 0.0);
    return true;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(reprojected_energy);
    if (any(greaterThanEqual(pixel, size))) return;
    vec4 energy = vec4(0.0), loss = vec4(0.0);
    if (!reproject_shadow(pixel, size, energy, loss)) {
        energy = vec4(0.0);
        loss = vec4(0.0);
    }
    imageStore(reprojected_energy, pixel, energy);
    imageStore(reprojected_loss, pixel, loss);
}
