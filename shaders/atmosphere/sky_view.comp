#version 460
#include "common/atmosphere.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D transmittance_lut;
layout(set = 0, binding = 2) uniform sampler2D multiscatter_lut;
layout(rgba16f, set = 0, binding = 3) uniform writeonly image2D radiance_lut;
layout(rgba16f, set = 0, binding = 4) uniform writeonly image2D throughput_lut;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, SKY_SIZE))) return;
    vec3 d = sky_direction(pixel);
    vec2 segment = angular_segment(pixel, d);
    vec3 L = vec3(0.0), tau = vec3(0.0);
    float previous = 0.0;
    for (int slice = 1; slice < AERIAL_SIZE.z; ++slice) {
        float end = aerial_distance(float(slice)/float(AERIAL_SIZE.z-1), segment.y-segment.x);
        integrate_atmosphere(transmittance_lut, multiscatter_lut, d, segment.x+previous, end-previous, L, tau);
        previous = end;
    }
    imageStore(radiance_lut, pixel, vec4(min(L, vec3(65000.0)), 1.0));
    imageStore(throughput_lut, pixel, vec4(exp(-tau), 1.0));
}
