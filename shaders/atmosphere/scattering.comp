#version 460
#include "common/atmosphere.glsl"
layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;
layout(set = 0, binding = 1) uniform sampler2D transmittance_lut;
layout(set = 0, binding = 2) uniform sampler2D multiscatter_lut;
layout(rgba16f, set = 0, binding = 3) uniform writeonly image3D rayleigh_lut;
layout(rgba16f, set = 0, binding = 4) uniform writeonly image3D mie_lut;

void main() {
    ivec3 pixel = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(pixel, SCATTERING_SIZE))) return;

    int nu_idx = pixel.x / SCATTERING_MU_S_SIZE;
    int mus_idx = pixel.x % SCATTERING_MU_S_SIZE;
    float u_nu = float(nu_idx) / float(SCATTERING_NU_SIZE - 1);
    float u_mus = float(mus_idx) / float(SCATTERING_MU_S_SIZE - 1);

    float u_mu;
    bool hits_ground;
    if (pixel.y < SCATTERING_MU_SIZE / 2) {
        u_mu = 0.5 * float(pixel.y) / float(SCATTERING_MU_SIZE / 2 - 1);
        hits_ground = true;
    } else {
        u_mu = 0.5 + 0.5 * float(pixel.y - SCATTERING_MU_SIZE / 2) / float(SCATTERING_MU_SIZE / 2 - 1);
        hits_ground = false;
    }
    float u_r = float(pixel.z) / float(SCATTERING_R_SIZE - 1);

    float r, mu, mu_s, nu;
    bruneton_unpack(u_r, u_mu, u_mus, u_nu, hits_ground, r, mu, mu_s, nu);

    vec3 p = vec3(0.0, 0.0, r);
    vec3 d = vec3(sqrt(max(1.0 - mu * mu, 0.0)), 0.0, mu);
    float s_z = mu_s;
    float s_x = (nu - mu * mu_s) / max(sqrt(max(1.0 - mu * mu, 0.0)), 1e-6);
    float s_y = sqrt(max(1.0 - s_x * s_x - s_z * s_z, 0.0));
    vec3 s = normalize(vec3(s_x, s_y, s_z));

    float d_end;
    if (hits_ground) {
        d_end = max(-r * mu - sqrt(max(r * r * (mu * mu - 1.0) + bottom_radius() * bottom_radius(), 0.0)), 0.0);
    } else {
        d_end = max(-r * mu + sqrt(max(r * r * (mu * mu - 1.0) + top_radius() * top_radius(), 0.0)), 0.0);
    }

    vec3 L_R = vec3(0.0);
    vec3 L_M = vec3(0.0);
    vec3 throughput = vec3(1.0);
    for (int i = 0; i < 48; ++i) {
        float t0 = float(i) / 48.0;
        float t1 = float(i + 1) / 48.0;
        t0 *= t0;
        t1 *= t1;
        float start = d_end*t0, span = d_end*(t1-t0);
        int subdivisions = transport_subdivisions(p, d, start, span);
        float dt = span/float(subdivisions);
        for (int j = 0; j < subdivisions; ++j) {
            vec3 q = p+d*(start+(float(j)+0.5)*dt);
            vec3 r_scat, m_scat, ext;
            medium(q, r_scat, m_scat, ext);
            vec3 int_ext = segment_integral(ext, dt);

            vec3 direct_trans = sun_transmittance(transmittance_lut, q, s);
            vec3 multiscatter = textureLod(multiscatter_lut, multiscatter_uv(q, s), 0.0).rgb * (r_scat + m_scat);

            L_R += throughput * (direct_trans * r_scat * rayleigh_phase(nu) + multiscatter) * int_ext;
            L_M += throughput * direct_trans * aerosol_source(q, nu) / aerosol_reference_phase(nu) * int_ext;
            throughput *= exp(-ext * dt);
        }
    }
    imageStore(rayleigh_lut, pixel, vec4(min(L_R, vec3(65000.0)), 1.0));
    imageStore(mie_lut, pixel, vec4(min(L_M, vec3(65000.0)), 1.0));
}
