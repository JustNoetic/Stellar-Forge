#version 460 core
layout(local_size_x=8,local_size_y=8) in;
#include "common/terrain_geometry_cache.glsl"
#include "common/terrain_surface.glsl"
layout(std430,binding=5) readonly buffer BakeJobs { TerrainBakeJob jobs[]; };
layout(std430,binding=7) writeonly buffer BakeHeights { float heights[]; };
uniform int u_resolution;
void main() {
    ivec2 ij=ivec2(gl_GlobalInvocationID.xy); int width=u_resolution+1;
    if (any(greaterThanEqual(ij,ivec2(width)))) return;
    int job_index=int(gl_GlobalInvocationID.z); TerrainBakeJob job=jobs[job_index];
    dvec2 uv=mix(dvec2(job.range.xy),dvec2(job.range.zw),dvec2(ij)/double(u_resolution));
    vec3 n=vec3(terrain_direction_precise(int(job.meta.x+0.5),uv));
    heights[job_index*width*width+ij.y*width+ij.x]=terrain_elevation(uint(job.meta.w+0.5),n,job.hrange,job.detail);
}
