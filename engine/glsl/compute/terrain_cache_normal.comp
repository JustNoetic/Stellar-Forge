#version 460 core
layout(local_size_x=8,local_size_y=8) in;
#include "common/terrain_geometry_cache.glsl"
#include "common/terrain_surface.glsl"
layout(std430,binding=5) readonly buffer BakeJobs { TerrainBakeJob jobs[]; };
layout(std430,binding=7) readonly buffer BakeHeights { float heights[]; };
layout(std430,binding=6) writeonly buffer CachedGeometry { vec4 geometry[]; };
uniform int u_resolution;
uniform float u_km_to_au;
void main() {
    ivec2 ij=ivec2(gl_GlobalInvocationID.xy);int width=u_resolution+1;
    if (any(greaterThanEqual(ij,ivec2(width)))) return;
    int job_index=int(gl_GlobalInvocationID.z);TerrainBakeJob job=jobs[job_index];
    int stride=width*width;float elevation=heights[job_index*stride+ij.y*width+ij.x];
    dvec2 uv=mix(dvec2(job.range.xy),dvec2(job.range.zw),dvec2(ij)/double(u_resolution));
    vec3 n=vec3(terrain_direction_precise(int(job.meta.x+0.5),uv));
    vec3 normal=terrain_surface_normal(uint(job.meta.w+0.5),n,job.shape.x/max(1e-12,u_km_to_au),clamp(job.shape.y,0.0,0.8),job.hrange,job.detail,elevation);
    int at=int(job.shape.z+0.5)*stride+ij.y*width+ij.x;
    geometry[at]=vec4(normal,elevation);
}
