#version 460 core
layout(local_size_x = 256) in;

layout(std430, binding = 2) buffer AllInstances {
    vec4 instances[];
};

layout(std430, binding = 3) buffer VisPoint { uint vis_point[]; };
layout(std430, binding = 4) buffer VisLo { uint vis_lo[]; };
layout(std430, binding = 5) buffer VisHi { uint vis_hi[]; };
layout(std430, binding = 6) buffer VisUltra { uint vis_ultra[]; };

struct DrawCmd {
    uint count;
    uint instanceCount;
    uint firstIndex;
    uint baseVertex;
    uint baseInstance;
};

layout(std430, binding = 7) buffer DrawCmds {
    DrawCmd cmds[4]; // point=0, lo=1, hi=2, ultra=3
};

layout(std430, binding = 8) buffer FocusMask {
    uint focused_mask[];
};

uniform int u_num_bodies;
uniform int u_star_idx;
uniform int u_n_casters;
uniform int u_caster_indices[64];
uniform vec4 u_frustum_planes[6];

uniform int u_n_rings;
uniform vec3 u_ring_centers[16];
uniform vec3 u_ring_normals[16];
uniform float u_ring_outer_radii[16];

uniform int u_tracking_idx;
uniform vec3 u_camera_pos;
uniform float u_screen_height;
uniform float u_fov_factor;
uniform float u_lod_thresh_ultra;
uniform float u_lod_thresh_hi;
uniform float u_exposure;

// Active refraction state (matches the refract uniforms fed to the draw shaders).
// Used to widen the frustum-test radius for bodies seen through a foreground
// atmosphere, so refracted subpixel bodies are not culled at screen edges.
uniform vec3 u_refract_center;
uniform float u_refract_radius;
uniform float u_refract_max_bend;
uniform float u_refract_scale_height;
uniform float u_au_to_km;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(u_num_bodies)) return;

    vec4 f0 = instances[idx * 7 + 0];
    vec4 f1 = instances[idx * 7 + 1];
    vec4 f2 = instances[idx * 7 + 2];

    vec3 pos = f0.xyz;
    float r = f1.z;
    float r_cull = r;

    // Refraction envelope: a body seen through a foreground atmosphere can be
    // displaced across the sky by up to ~tan(max_bend) * dist (mirrors the
    // bg_expand in sphere.vert). Widen the frustum-test radius accordingly so
    // refracted bodies are not culled when their true position leaves the
    // frustum. The s_min_r < d_body test excludes bodies in front of the
    // atmosphere (their light never traverses the dense shell). Above-horizon
    // rays (line periapsis behind the camera) are evaluated at the clamped
    // forward-ray periapsis — mirroring solve_refraction_apparent, which now
    // refracts above-horizon objects too (no s_min <= 0 gate there).
    if (u_refract_max_bend > 1e-6) {
        vec3 Cr = u_camera_pos - u_refract_center;
        vec3 to_body = pos - u_camera_pos;
        float d_body = length(to_body);
        if (d_body > 1e-9) {
            vec3 Vr = to_body / d_body;
            float s_min_r = -dot(Cr, Vr);
            if (s_min_r < d_body) {
                float s_fwd_r = max(s_min_r, 0.0);
                float r_min_r = length(Cr + s_fwd_r * Vr) * u_au_to_km;
                if (r_min_r < u_refract_radius + u_refract_scale_height * 15.0) {
                    r_cull += d_body * tan(u_refract_max_bend) * 1.5;
                }
            }
        }
    }

    // 1. Frustum Culling
    bool visible = true;
    for (int p = 0; p < 6; p++) {
        float dist = dot(pos, u_frustum_planes[p].xyz) + u_frustum_planes[p].w;
        if (dist < -r_cull * 1.05) {
            visible = false;
            break;
        }
    }

    // 2. Caster & Ring Masks
    uint mask_lo = 0;
    uint mask_hi = 0;
    uint r_mask = 0;

    vec3 star_pos = instances[u_star_idx * 7 + 0].xyz;
    float star_r = instances[u_star_idx * 7 + 1].z;

    if (idx != uint(u_star_idx)) {
        vec3 L = star_pos - pos;
        float dist_star = length(L);
        if (dist_star >= 1e-6) {
            vec3 L_dir = L / dist_star;

            for (int c = 0; c < u_n_casters; c++) {
                int j = u_caster_indices[c];
                if (j == int(idx) || j == u_star_idx) continue;

                vec3 p_j = instances[j * 7 + 0].xyz;
                float r_j = instances[j * 7 + 1].z;

                vec3 vec = p_j - pos;
                float t = dot(vec, L_dir);
                if (t > -(r + r_j) && t < dist_star + r_j) {
                    vec3 perp = vec - t * L_dir;
                    float d = length(perp);
                    float r_cone = r_j + star_r * max(0.0, t) / dist_star + r;
                    if (d < r_cone) {
                        if (c < 32) mask_lo |= (1u << c);
                        else mask_hi |= (1u << (c - 32));
                    }
                }
            }

            for (int k = 0; k < u_n_rings; k++) {
                vec3 C_k = u_ring_centers[k];
                vec3 N_k = u_ring_normals[k];
                float r_out = u_ring_outer_radii[k];

                float denom = dot(L_dir, N_k);
                if (abs(denom) > 1e-8) {
                    vec3 vec_c = C_k - pos;
                    float dist_centers = length(vec_c);
                    if (dist_centers < 1e-6) {
                        r_mask |= (1u << k);
                    } else {
                        float s = dot(vec_c, N_k) / denom;
                        if (s > -r && s < dist_star + r) {
                            vec3 hit = pos + s * L_dir;
                            float d = length(hit - C_k);
                            float r_cone = star_r * max(0.0, s) / dist_star + r;
                            if (d < r_out + r_cone) {
                                r_mask |= (1u << k);
                            }
                        }
                    }
                }
            }
        }
    }

    instances[idx * 7 + 3].y = uintBitsToFloat(mask_lo);
    instances[idx * 7 + 3].z = uintBitsToFloat(mask_hi);
    instances[idx * 7 + 3].w = uintBitsToFloat(r_mask);

    // 3. Lodge into visible buffers based on screen-space size & tracking state
    if (visible) {
        float cam_dist = length(pos - u_camera_pos);
        float apparent_px = (cam_dist > 1e-6) ? ((r / cam_dist) * u_screen_height * u_fov_factor) : 10000.0;

        bool is_star = (f2.x > 0.5);
        bool is_tracked = (int(idx) == u_tracking_idx);

        // --- Exposure-Dependent Photometric Flux Evaluation for Culling ---
        float exp_val = max(1e-6, u_exposure);
        float apparent_flux = 0.0;

        if (is_star) {
            float star_lum = max(instances[idx * 7 + 4].w, 1e-4);
            float star_r = max(r, 1e-6);
            float surf_lum = star_lum / (star_r * star_r);
            apparent_flux = apparent_px * apparent_px * surf_lum;
        } else {
            vec3 star_p = instances[u_star_idx * 7 + 0].xyz;
            float d_star = length(star_p - pos);
            float star_lum = max(instances[u_star_idx * 7 + 4].w, 1.0);
            float star_flux = star_lum / max(d_star * d_star, 1e-4);

            vec3 L = (d_star > 1e-6) ? ((star_p - pos) / d_star) : vec3(0.0, 1.0, 0.0);
            vec3 V = (cam_dist > 1e-6) ? ((u_camera_pos - pos) / cam_dist) : vec3(0.0, 0.0, 1.0);
            float cos_alpha = clamp(dot(V, L), -1.0, 1.0);
            float alpha = acos(cos_alpha);
            float phase_func = max(0.0, (sin(alpha) + (3.14159265 - alpha) * cos_alpha) / 3.14159265);

            vec3 body_col = vec3(f0.w, f1.x, f1.y);
            float alb = clamp(dot(body_col, vec3(0.2126, 0.7152, 0.0722)), 0.04, 1.0);
            apparent_flux = apparent_px * apparent_px * star_flux * alb * phase_func;
        }

        // Peak pixel signal on sensor
        float peak_signal = apparent_flux * exp_val;
        float limiting_threshold = 1.0e-5;

        // Dynamic culling for unresolved distant objects based on limiting magnitude
        if (!is_tracked && apparent_px < 2.0 && peak_signal < limiting_threshold) {
            visible = false;
        }

        if (visible) {
            bool is_ultra = is_tracked || (apparent_px >= u_lod_thresh_ultra);
            bool is_hi = !is_ultra && ((apparent_px >= u_lod_thresh_hi) || (is_star && apparent_px >= 2.0));
            bool is_lo = !is_ultra && !is_hi && (apparent_px >= 2.0);
            bool is_point = (apparent_px < 3.0);

            if (is_ultra) {
                uint slot = atomicAdd(cmds[3].instanceCount, 1u);
                vis_ultra[slot] = idx;
            } else if (is_hi) {
                uint slot = atomicAdd(cmds[2].instanceCount, 1u);
                vis_hi[slot] = idx;
            } else if (is_lo) {
                uint slot = atomicAdd(cmds[1].instanceCount, 1u);
                vis_lo[slot] = idx;
            }

            if (is_point) {
                uint slot = atomicAdd(cmds[0].instanceCount, 1u);
                vis_point[slot] = idx;
            }
        }
    }
}
